APP_ENV=local
HTTP_ADDR=:8080
DATABASE_URL=postgres://realmstack:realmstack@localhost:5432/realmstack?sslmode=disable
# Signs every access token. Generate one with: openssl rand -base64 48
# The API refuses placeholder values unless APP_ENV=local.
JWT_SECRET=replace-this-with-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
BODY_LIMIT_BYTES=1048576
DEMO_MODE=false
# Optional AI assistant (bring your own OpenAI key). Unset = AI disabled; everything else works.
# A base64-encoded 32-byte key that encrypts users' provider keys at rest. Generate one with
#   openssl rand -base64 32
# or in PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
# Changing it makes stored provider keys unreadable (users re-enter them).
AI_ENCRYPTION_KEY=
AI_TIMEOUT=3m
AI_MAX_OUTPUT_TOKENS=32000
AI_GENERATIONS_PER_MINUTE=6
AI_MAX_RUNNING_PER_USER=2
# OpenAI-compatible providers (OpenRouter, Groq, Ollama, ...) use a base URL the user enters. It must be
# https and public unless this is true, which also allows http and private addresses (a local model
# server). Leave false otherwise: users choose that URL.
# AI_ALLOW_PRIVATE_URLS=false

# Scale and operations. All optional.
# Migrations and maintenance connect here (a session advisory lock does not survive a
# transaction-mode pooler). Default: DATABASE_URL.
# DATABASE_DIRECT_URL=
# Read replica for lag-tolerant reads (leaderboard rankings, goal progress). Default: the primary.
# DATABASE_REPLICA_URL=
# Redis rank projection for leaderboards. Unset = ranks come from PostgreSQL.
# REDIS_URL=redis://localhost:6379/0
# Default per-project quotas (0 = built-in defaults: 1,200,000 requests/min, 600,000 writes/min, 500 batch entries).
# project_quotas rows override them per project.
# QUOTA_REQUESTS_PER_MINUTE=0
# QUOTA_WRITES_PER_MINUTE=0
# QUOTA_MAX_BATCH_ENTRIES=0
# Server-credential lookup cache (at most 60s).
# CREDENTIAL_CACHE_TTL=30s
# How often each instance reads ban changes made on other instances (bounds how long a
# newly banned player's access token keeps working elsewhere).
# BAN_SYNC_INTERVAL=5s
# How often partitions are created and expired idempotency records purged.
# MAINTENANCE_INTERVAL=1h
